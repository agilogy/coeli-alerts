{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh run view:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ktfmt-format.sh 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "Formatting Kotlin with ktfmt..."
          }
        ]
      }
    ]
  }
}
